# Copy this file to .env and fill in real values. .env is gitignored.
#
# Required by webapp/app.py
# ----------------------------------------------------------------------
# Fabric IQ Ontology MCP endpoint. Construct from your workspace and
# ontology IDs after Phase 4 of demo/RUNBOOK.md:
#   https://api.fabric.microsoft.com/v1/mcp/dataPlane/workspaces/<ws-id>/items/<ont-id>/ontologyEndpoint
MCP_ENDPOINT=

# Anthropic API key. Generate from https://platform.claude.com/
ANTHROPIC_API_KEY=

# Optional — defaults to "claude-opus-4-8" in app.py.
ANTHROPIC_MODEL=claude-opus-4-8

# Optional — override the path to the canonical agent prompt.
# Default: agent_prompt.md beside app.py, then ../config/agent_prompt.md
# AGENT_PROMPT_PATH=
