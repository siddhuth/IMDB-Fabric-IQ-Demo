# Copy this file to .env and fill in real values. .env is gitignored.
#
# Required by webapp/app.py
# ----------------------------------------------------------------------
# Fabric IQ Ontology MCP endpoint. Construct from your workspace and
# ontology IDs after Phase 4 of demo/RUNBOOK.md:
#   https://api.fabric.microsoft.com/v1/mcp/dataPlane/workspaces/<ws-id>/items/<ont-id>/ontologyEndpoint
MCP_ENDPOINT=

# Databricks workspace that hosts a Claude model-serving endpoint.
# Example: https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_HOST=

# Databricks personal access token (or service principal token).
# Generate from: User Settings → Developer → Access tokens.
DATABRICKS_TOKEN=

# Optional — defaults to "databricks-claude-sonnet-4" in app.py.
# Use whatever Claude variant your Databricks workspace has provisioned.
DATABRICKS_MODEL=databricks-claude-sonnet-4
